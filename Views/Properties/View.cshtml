@model PropertyDetailsViewModel
@{
    var p = Model.Property;
    ViewData["Title"] = p.Title;
    var images = p.Images.ToList();
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="stylesheet" href="~/css/staybnb.css" asp-append-version="true" />

<partial name="_Alerts" />

@if (!p.IsActive)
{
    <div class="alert alert-warning">Preview: this listing is not active, so guests cannot see or book it.</div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">@p.Title</h2>
        <div class="text-muted"><i class="fa-solid fa-location-dot"></i> @p.City, South Africa</div>
        <div class="small mt-1">
            <i class="fa-solid fa-user-group"></i> @p.MaxGuests guests
            <span class="mx-2"><i class="fa-solid fa-bed"></i> @p.Bedrooms bedrooms, @p.Beds beds</span>
            <i class="fa-solid fa-bath"></i> @p.Bathrooms baths
            <span class="ms-2"><i class="fa-solid fa-star text-brand"></i> @Model.AverageRating.ToString("0.0") (@p.Reviews.Count reviews)</span>
        </div>
    </div>
    <div class="text-center">
        <div class="host-avatar mx-auto">@(p.Host?.FirstName.FirstOrDefault())</div>
        <div class="small fw-semibold mt-1">@p.Host?.FullName</div>
        <span class="badge bg-danger">Verified Host</span>
    </div>
</div>

<div class="photo-grid @(images.Count < 3 ? "single" : "") mb-4">
    @if (images.Any())
    {
        <img src="@images[0].ImageUrl" class="main" alt="@p.Title" />
    }
    @if (images.Count >= 3)
    {
        <img src="@images[1].ImageUrl" alt="" />
        <img src="@images[2].ImageUrl" alt="" />
    }
</div>
@if (images.Count > 3 || images.Count == 2)
{
    <div class="d-flex gap-2 mb-4 overflow-auto">
        @foreach (var img in images.Skip(images.Count >= 3 ? 3 : 1))
        {
            <a href="@img.ImageUrl" target="_blank"><img src="@img.ImageUrl" alt="" class="rounded" style="height:90px;width:130px;object-fit:cover" /></a>
        }
    </div>
}

<div class="row g-5">
    <div class="col-lg-7">
        <p style="white-space:pre-line">@p.Description</p>
        <hr />

        <h4 class="mb-3">Amenities</h4>
        @if (!p.Amenities.Any())
        {
            <p class="text-muted">No amenities listed.</p>
        }
        <div class="row">
            @foreach (var a in p.Amenities)
            {
                <div class="col-6"><div class="amenity"><i class="@a.IconClass"></i> @a.Name</div></div>
            }
        </div>
        <hr />

        @if (Model.UnavailableRanges.Any())
        {
            <h5>Already booked</h5>
            <ul class="small text-muted">
                @foreach (var b in Model.UnavailableRanges)
                {
                    <li>@b.CheckInDate.ToString("dd MMM yyyy") to @b.CheckOutDate.ToString("dd MMM yyyy")</li>
                }
            </ul>
            <hr />
        }

        <h4 class="mb-3"><i class="fa-solid fa-star text-brand"></i> @Model.AverageRating.ToString("0.0") · @p.Reviews.Count reviews</h4>
        @if (!p.Reviews.Any())
        {
            <p class="text-muted">No reviews yet.</p>
        }
        @foreach (var r in p.Reviews.OrderByDescending(r => r.CreatedAt))
        {
            <div class="mb-3">
                <strong>@r.Reviewer?.FullName</strong>
                <span class="text-muted small ms-2">@r.CreatedAt.ToString("MMM yyyy")</span>
                <div class="text-brand small">@for (var i = 0; i < r.Rating; i++) { <i class="fa-solid fa-star"></i> }</div>
                <p class="mb-0">@r.Comment</p>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="booking-widget">
            <div class="mb-3"><span class="fs-4 fw-bold">@Ui.Rand(p.PricePerNight)</span> <span class="text-muted">/ night</span></div>

            <form asp-controller="Bookings" asp-action="Create" method="post" id="booking-form">
                <input type="hidden" name="PropertyId" value="@p.Id" />
                <div class="date-box mb-3">
                    <div class="d-flex">
                        <div class="cell flex-fill">
                            <label for="CheckIn">Check-in</label>
                            <input type="date" id="CheckIn" name="CheckIn" value="@Model.DefaultCheckIn.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="cell flex-fill">
                            <label for="CheckOut">Checkout</label>
                            <input type="date" id="CheckOut" name="CheckOut" value="@Model.DefaultCheckOut.ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="guests d-flex justify-content-between align-items-center">
                        <div><label>Guests</label><small class="text-muted">Max @p.MaxGuests</small></div>
                        <div class="stepper d-flex align-items-center gap-2">
                            <button type="button" data-step="-1">-</button>
                            <input type="number" id="Guests" name="Guests" value="1" min="1" max="@p.MaxGuests" readonly style="width:30px;text-align:center" />
                            <button type="button" data-step="1">+</button>
                        </div>
                    </div>
                </div>

                @if (Model.IsGuest && p.IsActive)
                {
                    <button type="submit" id="reserve" class="btn btn-brand btn-lg w-100" disabled>Reserve</button>
                    <p class="text-center small text-muted mt-2 mb-0">You won't be charged until the host approves</p>
                }
                else if (!Model.IsSignedIn)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("View", "Properties", new { id = p.Id })" class="btn btn-brand btn-lg w-100">Log in to book</a>
                }
                else
                {
                    <div class="alert alert-secondary small mb-0">Only Guest accounts can book stays.</div>
                }
            </form>

            <div id="quote" class="mt-3">
                <div class="price-line"><span id="q-nights"></span><span id="q-subtotal"></span></div>
                <div class="price-line"><span>Cleaning fee</span><span id="q-cleaning"></span></div>
                <div class="price-line"><span>Service fee</span><span id="q-service"></span></div>
                <hr />
                <div class="price-line fw-bold"><span>Total</span><span id="q-total"></span></div>
            </div>
            <div id="quote-error" class="text-danger small mt-2"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const quoteUrl = '@Url.Action("Quote", "Bookings")';
        const propertyId = @p.Id;
        const checkIn = document.getElementById('CheckIn');
        const checkOut = document.getElementById('CheckOut');
        const guests = document.getElementById('Guests');
        const reserve = document.getElementById('reserve');
        const quoteBox = document.getElementById('quote');
        const errorBox = document.getElementById('quote-error');

        async function refreshQuote() {
            const params = new URLSearchParams({ propertyId, checkIn: checkIn.value, checkOut: checkOut.value, guests: guests.value });
            const res = await fetch(`${quoteUrl}?${params}`);
            const q = await res.json();
            if (!q.ok) {
                quoteBox.style.display = 'none';
                errorBox.textContent = q.error;
                if (reserve) reserve.disabled = true;
                return;
            }
            errorBox.textContent = '';
            quoteBox.style.display = '';
            document.getElementById('q-nights').textContent = q.nightsLine;
            document.getElementById('q-subtotal').textContent = q.subtotal;
            document.getElementById('q-cleaning').textContent = q.cleaningFee;
            document.getElementById('q-service').textContent = q.serviceFee;
            document.getElementById('q-total').textContent = q.total;
            if (reserve) reserve.disabled = false;
        }

        checkIn.addEventListener('change', () => {
            // keep checkout at least one night after check-in
            const next = new Date(checkIn.value); next.setDate(next.getDate() + 1);
            const min = next.toISOString().slice(0, 10);
            checkOut.min = min;
            if (checkOut.value <= checkIn.value) checkOut.value = min;
            refreshQuote();
        });
        checkOut.addEventListener('change', refreshQuote);
        document.querySelectorAll('.stepper button').forEach(btn => btn.addEventListener('click', () => {
            const value = Math.min(Math.max(+guests.value + +btn.dataset.step, 1), +guests.max);
            guests.value = value;
            refreshQuote();
        }));
        refreshQuote();
    </script>
}
