@model Staybnb.ViewModels.HostApplicationViewModel
@{
    ViewData["Title"] = "Become a Host";
    var isHost = User.IsInRole(AppRoles.Host);
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <partial name="_Alerts" />
        <h2 class="mb-1">@(isHost ? "List another property" : "Become a Host")</h2>
        <p class="text-muted mb-4">Tell us about your place. An admin reviews every application before it goes live.</p>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="card shadow-sm p-4 mb-3">
                <h5 class="mb-3">1. The basics</h5>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Cozy Forest Cabin" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PropertyType" class="form-label"></label>
                        <select asp-for="PropertyType" class="form-select"
                                asp-items="@(new SelectList(Staybnb.ViewModels.HostApplicationViewModel.PropertyTypes))"></select>
                        <span asp-validation-for="PropertyType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Durban" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-1">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="card shadow-sm p-4 mb-3">
                <h5 class="mb-3">2. The space</h5>
                <div class="row">
                    <div class="col-6 col-md-3 mb-2">
                        <label asp-for="MaxGuests" class="form-label"></label>
                        <input asp-for="MaxGuests" type="number" min="1" class="form-control" />
                        <span asp-validation-for="MaxGuests" class="text-danger"></span>
                    </div>
                    <div class="col-6 col-md-3 mb-2">
                        <label asp-for="Bedrooms" class="form-label"></label>
                        <input asp-for="Bedrooms" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-6 col-md-3 mb-2">
                        <label asp-for="Beds" class="form-label"></label>
                        <input asp-for="Beds" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-6 col-md-3 mb-2">
                        <label asp-for="Bathrooms" class="form-label"></label>
                        <input asp-for="Bathrooms" type="number" min="0" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="card shadow-sm p-4 mb-3">
                <h5 class="mb-3">3. Pricing</h5>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label asp-for="PricePerNight" class="form-label"></label>
                        <input asp-for="PricePerNight" type="number" step="0.01" min="50" class="form-control" />
                        <span asp-validation-for="PricePerNight" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label asp-for="CleaningFee" class="form-label"></label>
                        <input asp-for="CleaningFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="CleaningFee" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm p-4 mb-3">
                <h5 class="mb-3">4. Amenities</h5>
                <div class="row">
                    @foreach (var a in Model.AvailableAmenities)
                    {
                        <div class="col-6 col-md-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedAmenityIds"
                                       value="@a.Id" id="amenity-@a.Id" checked="@Model.SelectedAmenityIds.Contains(a.Id)" />
                                <label class="form-check-label" for="amenity-@a.Id"><i class="@a.IconClass me-1"></i> @a.Name</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm p-4 mb-4">
                <h5 class="mb-1">5. Photos</h5>
                <p class="text-muted small">At least one image is required. JPG, PNG or WEBP, up to 5MB each, maximum 10.</p>
                <input asp-for="Images" type="file" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control" required />
                <span asp-validation-for="Images" class="text-danger"></span>
                <div id="preview" class="mt-3"></div>
            </div>

            <button type="submit" class="btn btn-danger btn-lg w-100 mb-5">Submit application</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('Images').addEventListener('change', function () {
            const box = document.getElementById('preview');
            box.innerHTML = '';
            [...this.files].forEach(f => {
                const img = document.createElement('img');
                img.src = URL.createObjectURL(f);
                img.className = 'rounded me-2 mb-2';
                img.style.cssText = 'width:120px;height:90px;object-fit:cover';
                box.appendChild(img);
            });
        });
    </script>
}
