<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staybnb.css" asp-append-version="true" />
</head>
<body class="site">
    <header class="site-header">
        <div class="container-xl d-flex align-items-center justify-content-between gap-3 py-3">
            <a class="site-brand" asp-controller="Properties" asp-action="Index"><i class="fa-solid fa-house-chimney"></i> staybnb</a>

            <a class="header-search d-none d-lg-flex" asp-controller="Properties" asp-action="Index">
                <span>Anywhere</span><span>Any week</span><span class="text-muted">Add guests</span>
                <i class="fa-solid fa-magnifying-glass"></i>
            </a>

            <partial name="_LoginPartial" />
        </div>
    </header>

    <main class="container-xl py-4">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-xl d-flex justify-content-between flex-wrap gap-2 py-3 small text-muted">
            <span>&copy; @DateTime.Now.Year Staybnb, a managed property rental marketplace</span>
            <span>ASP.NET Core MVC, EF Core and SQL Server</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
