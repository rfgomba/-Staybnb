@model HostApplicationViewModel
@{
    var isHost = User.IsInRole(AppRoles.Host);
    ViewData["Title"] = isHost ? "Add Property" : "Become a Host";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="row justify-content-center">
    <div class="col-lg-9">
        <partial name="_Alerts" />
        @if (!isHost)
        {
            <h2 class="mb-1">Become a Host</h2>
        }
        <p class="text-muted mb-4">Tell us about your place. An admin reviews every application before it goes live.</p>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <partial name="_PropertyFields" model="Model" />

            <div class="card shadow-sm p-4 mb-4">
                <h5 class="mb-1">5. Photos</h5>
                <p class="text-muted small">At least one image is required. JPG, PNG or WEBP, up to 5MB each, maximum 10.</p>
                <input asp-for="Images" type="file" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control" required data-preview="preview" />
                <span asp-validation-for="Images" class="text-danger"></span>
                <div id="preview" class="mt-3"></div>
            </div>

            <button type="submit" class="btn btn-danger btn-lg w-100 mb-5">Submit application</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-preview.js" asp-append-version="true"></script>
}
