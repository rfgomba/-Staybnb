@model ActivityLogFilterViewModel
@{ ViewData["Title"] = "Activity Logs"; }

<form method="get" class="dash-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">Search user or action</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="e.g. RoleChange or an email" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Type</label>
            <select name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in Enum.GetValues<ActivityType>())
                {
                    <option value="@t" selected="@(t.ToString() == Model.Type)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">From</label>
            <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">To</label>
            <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
            <a asp-action="ActivityLogs" class="btn btn-outline-dark">Clear</a>
        </div>
    </div>
    <div class="mt-2 small">
        Quick filters:
        <a asp-action="ActivityLogs" asp-route-type="Security" class="badge bg-danger text-decoration-none">Security</a>
        <a asp-action="ActivityLogs" asp-route-type="RoleChange" class="badge bg-primary text-decoration-none">Role changes</a>
        <a asp-action="ActivityLogs" asp-route-type="Login" class="badge bg-secondary text-decoration-none">Logins</a>
        <a asp-action="ActivityLogs" asp-route-type="BookingStatusChange" class="badge bg-success text-decoration-none">Booking status</a>
    </div>
</form>

<div class="dash-card">
    <p class="small text-muted">@Model.TotalCount events found</p>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Date</th><th>User</th><th>Action</th><th>Type</th></tr></thead>
            <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td class="text-nowrap">@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@(log.User?.FullName ?? "System / anonymous")<br /><small class="text-muted">@log.User?.Email</small></td>
                    <td>@log.Action</td>
                    <td><span class="badge @Ui.ActivityBadge(log.ActivityType)">@log.ActivityType</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm mb-0">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="ActivityLogs" asp-route-page="@i" asp-route-type="@Model.Type"
                           asp-route-search="@Model.Search" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
