@model HostDashboardViewModel
@{ ViewData["Title"] = "Host Dashboard"; }

<partial name="_Alerts" />

<div class="dash-card mb-4">
    <h4 class="text-brand mb-1">Welcome back, @Model.HostName!</h4>
    <p class="text-muted mb-3">Here's what's happening with your properties today.</p>
    <a asp-controller="HostApplication" asp-action="Create" class="btn btn-outline-brand btn-sm me-2"><i class="fa-solid fa-plus"></i> Add New Property</a>
    <a asp-action="Properties" class="btn btn-outline-brand btn-sm"><i class="fa-solid fa-house"></i> My Properties</a>
</div>

@if (Model.MissingCheckInSetup > 0)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        @Model.MissingCheckInSetup approved @(Model.MissingCheckInSetup == 1 ? "property has" : "properties have") no check-in process yet.
        <a asp-action="Properties" class="alert-link">Set it up</a> so guests know which documents to upload.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon bg-soft-blue"><i class="fa-solid fa-house"></i></div>
            <div class="stat-value">@Model.TotalProperties</div>
            <div class="stat-label">Total Properties</div>
            <div class="stat-sub text-success"><i class="fa-solid fa-arrow-up"></i> @Model.ActiveProperties active</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon bg-soft-purple"><i class="fa-solid fa-calendar-days"></i></div>
            <div class="stat-value">@Model.TotalBookings</div>
            <div class="stat-label">Total Bookings</div>
            <div class="stat-sub text-muted">@Model.BookingsThisMonth this month</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon bg-soft-green"><i class="fa-solid fa-money-bill-wave"></i></div>
            <div class="stat-value">@Ui.Rand(Model.TotalEarnings)</div>
            <div class="stat-label">Total Earnings</div>
            <div class="stat-sub text-muted">@Ui.Rand(Model.EarningsThisMonth) this month</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon bg-soft-orange"><i class="fa-solid fa-star"></i></div>
            <div class="stat-value">@Model.AverageRating.ToString("0.0")</div>
            <div class="stat-label">Average Rating</div>
            <div class="stat-sub text-muted">@Model.ReviewCount reviews</div>
        </div>
    </div>
</div>

<div class="dash-card mb-4">
    <h6 class="mb-3">Performance Metrics <small class="text-muted">(this month)</small></h6>
    <div class="row g-3">
        <div class="col-6 col-lg-3"><div class="metric"><strong>@Model.OccupancyRate.ToString("0.0")%</strong><span>Occupancy rate</span></div></div>
        <div class="col-6 col-lg-3"><div class="metric"><strong>@Model.PendingRequests</strong><span>Pending requests</span></div></div>
        <div class="col-6 col-lg-3"><div class="metric"><strong>@Ui.Rand(Model.AverageNightlyRate)</strong><span>Avg nightly rate</span></div></div>
        <div class="col-6 col-lg-3"><div class="metric"><strong>@Ui.Rand(Model.AverageBookingValue)</strong><span>Avg booking value</span></div></div>
    </div>
</div>

<div class="dash-card">
    <h6 class="mb-3">Recent Bookings</h6>
    @if (!Model.RecentBookings.Any())
    {
        <p class="text-muted mb-0">No bookings yet. They will appear here once guests start booking your properties.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Total</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var b in Model.RecentBookings)
                {
                    <tr>
                        <td>@b.Guest?.FullName</td>
                        <td>@b.Property?.Title</td>
                        <td>@b.CheckInDate.ToString("dd MMM") to @b.CheckOutDate.ToString("dd MMM")</td>
                        <td>@Ui.Rand(b.TotalPrice)</td>
                        <td><span class="badge @Ui.BookingBadge(b.Status)">@b.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
