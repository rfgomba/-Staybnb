@model List<AdminPropertyRow>
@{ ViewData["Title"] = "Properties"; }

<partial name="_Alerts" />

<div class="dash-card">
    <p class="small text-muted">@Model.Count listings. Deactivating a listing hides it from guests and notifies the host.</p>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Listing</th><th>Host</th><th>City</th><th>Price</th><th>Bookings</th><th>Review</th><th>Visibility</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var p = row.Property;
                var img = p.Images.FirstOrDefault()?.ImageUrl;
                <tr>
                    <td>
                        @if (img != null)
                        {
                            <img src="@img" alt="" class="rounded me-2" style="width:56px;height:42px;object-fit:cover" />
                        }
                        <strong>@p.Title</strong>
                    </td>
                    <td>@p.Host?.FullName</td>
                    <td>@p.City</td>
                    <td>@Ui.Rand(p.PricePerNight)</td>
                    <td>@p.Bookings.Count</td>
                    <td><span class="badge @Ui.ApplicationBadge(row.Status)">@(row.Status?.ToString() ?? "None")</span></td>
                    <td><span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a asp-controller="Properties" asp-action="View" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark" target="_blank"><i class="fa-solid fa-eye"></i></a>
                            @if (row.Status == ApplicationStatus.Approved)
                            {
                                <form asp-action="ToggleProperty" asp-route-id="@p.Id" method="post" onsubmit="return confirm('@(p.IsActive ? "Deactivate" : "Activate") this listing?');">
                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(p.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
