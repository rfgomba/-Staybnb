@model int
@{
    ViewData["Title"] = Model == 404 ? "Page not found" : "Something went wrong";
}
<div class="text-center py-5">
    <div class="display-1 fw-bold text-brand">@Model</div>
    <h3>@ViewData["Title"]</h3>
    <p class="text-muted">@(Model == 404 ? "We can't find the page you're looking for." : "Please try again in a moment.")</p>
    <a asp-controller="Properties" asp-action="Index" class="btn btn-brand">Back to stays</a>
</div>
