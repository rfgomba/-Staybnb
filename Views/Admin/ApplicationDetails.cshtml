@model HostApplication
@{
    ViewData["Title"] = "Review Application";
    var p = Model.Property!;
    var badge = Model.Status switch
    {
        ApplicationStatus.Approved => "bg-success",
        ApplicationStatus.Rejected => "bg-danger",
        _ => "bg-warning text-dark"
    };
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<partial name="_Alerts" />
<a asp-action="Applications" class="text-decoration-none">&larr; Back to Host Requests</a>

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h2 class="mb-0">@p.Title</h2>
    <span class="badge fs-6 @badge">@Model.Status</span>
</div>

<div class="row g-2 mb-4">
    @foreach (var img in p.Images)
    {
        <div class="col-6 col-md-4">
            <a href="@img.ImageUrl" target="_blank">
                <img src="@img.ImageUrl" alt="" class="rounded" style="width:100%;height:200px;object-fit:cover" />
            </a>
        </div>
    }
</div>

<div class="row">
    <div class="col-md-8">
        <h5>Description</h5>
        <p style="white-space:pre-line">@p.Description</p>

        <h5 class="mt-4">Details</h5>
        <table class="table table-sm">
            <tr><th style="width:35%">Type</th><td>@p.PropertyType</td></tr>
            <tr><th>Address</th><td>@p.Address, @p.City</td></tr>
            <tr><th>Guests</th><td>@p.MaxGuests</td></tr>
            <tr><th>Rooms</th><td>@p.Bedrooms bedrooms, @p.Beds beds, @p.Bathrooms bathrooms</td></tr>
            <tr><th>Price per night</th><td>R @p.PricePerNight.ToString("N2")</td></tr>
            <tr><th>Cleaning fee</th><td>R @p.CleaningFee.ToString("N2")</td></tr>
        </table>

        <h5 class="mt-4">Amenities</h5>
        @if (!p.Amenities.Any())
        {
            <p class="text-muted">None selected.</p>
        }
        @foreach (var a in p.Amenities)
        {
            <span class="badge bg-light text-dark border me-1 mb-1 p-2"><i class="@a.IconClass me-1"></i>@a.Name</span>
        }
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Applicant</h6>
            <p class="mb-0"><strong>@Model.ApplicationUser?.FullName</strong></p>
            <p class="text-muted small">@Model.ApplicationUser?.Email</p>
            <p class="small mb-3">Applied @Model.AppliedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>

            @if (Model.Status == ApplicationStatus.Pending)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="mb-3">
                    <button type="submit" class="btn btn-success w-100">Approve</button>
                </form>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                    <textarea name="comment" class="form-control mb-2" rows="3" maxlength="500" required
                              placeholder="Reason for rejection (shown to the applicant)"></textarea>
                    <button type="submit" class="btn btn-outline-danger w-100">Reject</button>
                </form>
            }
            else
            {
                <p class="small mb-1">Reviewed @Model.ReviewedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                @if (!string.IsNullOrEmpty(Model.AdminComment))
                {
                    <p class="small text-danger mb-0">Reason: @Model.AdminComment</p>
                }
            }
        </div>
    </div>
</div>
