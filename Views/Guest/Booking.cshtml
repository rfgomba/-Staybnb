@model Booking
@{
    ViewData["Title"] = "Booking details";
    var p = Model.Property!;
    var paid = Model.Payment?.Status == PaymentStatus.Paid;
    var checkInStatus = Model.GuestCheckIn?.Status;
    var cancelled = Model.Status is BookingStatus.Rejected or BookingStatus.Cancelled;
    var reachedApproved = Model.Status is BookingStatus.Approved or BookingStatus.CheckedIn or BookingStatus.Completed;
    var reachedCheckedIn = Model.Status is BookingStatus.CheckedIn or BookingStatus.Completed;
    var subtotal = Model.TotalPrice - Model.CleaningFee - Model.ServiceFee;

    var timeline = new List<(string Label, bool Done)>
    {
        ("Request sent", true),
        ("Approved by host", reachedApproved),
        ("Payment completed", paid),
        ("Check-in documents submitted", checkInStatus is CheckInStatus.Submitted or CheckInStatus.Verified || reachedCheckedIn),
        ("Documents verified", checkInStatus == CheckInStatus.Verified || reachedCheckedIn),
        ("Checked in", reachedCheckedIn)
    };
    var currentIndex = timeline.FindIndex(t => !t.Done);
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="stylesheet" href="~/css/staybnb.css" asp-append-version="true" />

<partial name="_Alerts" />
<a asp-action="Trips" class="text-decoration-none">&larr; My Trips</a>

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h2 class="mb-0">@p.Title</h2>
    <span class="badge fs-6 @Ui.BookingBadge(Model.Status)">@Model.Status</span>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm p-4 mb-3">
            <div class="row">
                <div class="col-6"><small class="text-muted">Check-in</small><div class="fw-semibold">@Model.CheckInDate.ToString("ddd, dd MMM yyyy")</div></div>
                <div class="col-6"><small class="text-muted">Checkout</small><div class="fw-semibold">@Model.CheckOutDate.ToString("ddd, dd MMM yyyy")</div></div>
            </div>
            <hr />
            <div class="small"><i class="fa-solid fa-location-dot"></i> @p.Address, @p.City</div>
            <div class="small"><i class="fa-solid fa-user-group"></i> @Model.NumberOfGuests guests, hosted by @p.Host?.FullName</div>
        </div>

        <div class="card shadow-sm p-4 mb-3">
            <h5 class="mb-3">Price details</h5>
            <div class="price-line"><span>@Ui.Rand(p.PricePerNight) x @Model.Nights nights</span><span>@Ui.Rand(subtotal, 2)</span></div>
            <div class="price-line"><span>Cleaning fee</span><span>@Ui.Rand(Model.CleaningFee, 2)</span></div>
            <div class="price-line"><span>Service fee</span><span>@Ui.Rand(Model.ServiceFee, 2)</span></div>
            <hr />
            <div class="price-line fw-bold"><span>Total</span><span>@Ui.Rand(Model.TotalPrice, 2)</span></div>
            <div class="small text-muted">Payment status: @(Model.Payment?.Status.ToString() ?? "None")</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (Model.Status == BookingStatus.Approved && !paid)
            {
                <form asp-action="Pay" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-brand"><i class="fa-solid fa-credit-card"></i> Pay @Ui.Rand(Model.TotalPrice, 2) (simulated)</button>
                </form>
            }
            @if (Model.Status == BookingStatus.Approved && paid)
            {
                <a asp-action="CheckIn" asp-route-id="@Model.Id" class="btn btn-brand">
                    <i class="fa-solid fa-id-card"></i>
                    @(checkInStatus switch
                    {
                        CheckInStatus.Verified => "View check-in",
                        CheckInStatus.Submitted => "Update check-in",
                        CheckInStatus.Rejected => "Fix check-in documents",
                        _ => "Start check-in"
                    })
                </a>
            }
            @if (Model.Status is BookingStatus.Pending or BookingStatus.Approved)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this booking?');">
                    <button type="submit" class="btn btn-outline-danger">Cancel booking</button>
                </form>
            }
            <a asp-controller="Messages" asp-action="Index" asp-route-with="@p.HostId" class="btn btn-outline-dark"><i class="fa-solid fa-envelope"></i> Message host</a>
            <a asp-controller="Properties" asp-action="View" asp-route-id="@p.Id" class="btn btn-outline-dark">View listing</a>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm p-4">
            <h5 class="mb-3">Progress</h5>
            @if (cancelled)
            {
                <div class="alert alert-danger mb-0">This booking was @Model.Status.ToString().ToLower().</div>
            }
            else
            {
                <ul class="timeline">
                    @for (var i = 0; i < timeline.Count; i++)
                    {
                        var css = timeline[i].Done ? "done" : i == currentIndex ? "current" : "";
                        <li class="@css">
                            <span class="dot">@(timeline[i].Done ? "✓" : (i + 1).ToString())</span>
                            <span>@timeline[i].Label</span>
                        </li>
                    }
                </ul>
                if (checkInStatus == CheckInStatus.Rejected)
                {
                    <div class="alert alert-danger small mb-0 mt-2">The host rejected a document. Please upload it again.</div>
                }
            }
        </div>
    </div>
</div>
