@model List<HostPropertyListItem>
@{ ViewData["Title"] = "My Properties"; }

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count @(Model.Count == 1 ? "property" : "properties")</p>
    <a asp-controller="HostApplication" asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus"></i> Add New Property</a>
</div>

@if (!Model.Any())
{
    <div class="dash-card text-center text-muted">You have no properties yet.</div>
}

@foreach (var item in Model)
{
    var p = item.Property;
    var img = p.Images.FirstOrDefault()?.ImageUrl;

    <div class="dash-card p-0 mb-3 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-3 position-relative">
                @if (img != null)
                {
                    <img src="@img" class="prop-thumb" alt="@p.Title" />
                }
                <span class="photo-count"><i class="fa-solid fa-camera"></i> @p.Images.Count</span>
            </div>
            <div class="col-md-9">
                <div class="p-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="mb-0">@p.Title</h5>
                            <small class="text-muted"><i class="fa-solid fa-location-dot"></i> @p.City</small>
                        </div>
                        <div class="fw-bold fs-5 text-nowrap">@Ui.Rand(p.PricePerNight, 2)<small class="text-muted fw-normal">/night</small></div>
                    </div>

                    <div class="text-muted small my-2">
                        <i class="fa-solid fa-user-group"></i> @p.MaxGuests guests
                        <span class="mx-2"><i class="fa-solid fa-bed"></i> @p.Bedrooms bedrooms, @p.Beds beds</span>
                        <i class="fa-solid fa-bath"></i> @p.Bathrooms bathrooms
                    </div>

                    <span class="badge bg-light text-dark border">@p.PropertyType</span>
                    @if (!item.IsApproved)
                    {
                        <span class="badge @Ui.ApplicationBadge(item.Status)">@(item.Status == ApplicationStatus.Rejected ? "Rejected" : "Pending review")</span>
                    }
                    else if (p.IsActive)
                    {
                        <span class="badge bg-success"><i class="fa-solid fa-circle-check"></i> Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                    @if (p.CheckInProcess != null)
                    {
                        <span class="badge bg-light text-success border"><i class="fa-solid fa-list-check"></i> Check-in ready</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-danger border"><i class="fa-solid fa-list-check"></i> No check-in process</span>
                    }

                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <small class="text-muted">
                            <i class="fa-solid fa-calendar"></i> @p.Bookings.Count @(p.Bookings.Count == 1 ? "booking" : "bookings")
                            <span class="ms-2"><i class="fa-solid fa-star"></i> @(p.Reviews.Any() ? p.Reviews.Average(r => r.Rating).ToString("0.0") : "No reviews")</span>
                        </small>
                        <div class="d-flex gap-2">
                            <a asp-action="CheckIn" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-list-check"></i> Check-in Setup</a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i> Edit</a>
                            @if (item.IsApproved)
                            {
                                <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post">
                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-success")">
                                        <i class="fa-solid @(p.IsActive ? "fa-pause" : "fa-play")"></i> @(p.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
